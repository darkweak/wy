// Package weak, interpreted from source. Adapted from
// GOROOT/src/weak/pointer.go; the weak handles are the host's.
package weak

import "unsafe"

// Pointer is a weak pointer to a value of type T.
type Pointer[T any] struct {
	_ [0]*T
	u unsafe.Pointer
}

// Make creates a weak pointer from a pointer to some value of type T.
func Make[T any](ptr *T) Pointer[T] {
	var u unsafe.Pointer
	if ptr != nil {
		u = registerWeakPointer(unsafe.Pointer(ptr))
	}
	return Pointer[T]{u: u}
}

// Value returns the original pointer used to create the weak pointer. It
// returns nil if the value pointed to by the original pointer was reclaimed
// by the garbage collector.
func (p Pointer[T]) Value() *T {
	if p.u == nil {
		return nil
	}
	return (*T)(makeStrongFromWeak(p.u))
}

// Implemented by the host.
func registerWeakPointer(unsafe.Pointer) unsafe.Pointer
func makeStrongFromWeak(unsafe.Pointer) unsafe.Pointer
