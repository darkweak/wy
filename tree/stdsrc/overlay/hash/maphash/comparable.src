// Generic functions and types of package hash/maphash, interpreted from
// source. The hashing is done by the host's maphash on the value boxed in an
// interface.
package maphash

import real "hash/maphash"

// Comparable returns the hash of comparable value v with the given seed such
// that Comparable(s, v1) == Comparable(s, v2) if v1 == v2.
func Comparable[T comparable](seed real.Seed, v T) uint64 { return comparableHash(seed, v) }

// WriteComparable adds x to the data hashed by h.
func WriteComparable[T comparable](h *real.Hash, x T) { writeComparable(h, x) }

// A Hasher is a type that implements hashing and equality for type T.
type Hasher[T any] interface {
	Hash(*real.Hash, T)
	Equal(x, y T) bool
}

// ComparableHasher is an implementation of [Hasher] for comparable types.
type ComparableHasher[T comparable] struct {
	_ [0]func(T) // disallow comparison, and conversion between ComparableHasher[X] and ComparableHasher[Y]
}

func (ComparableHasher[T]) Hash(h *real.Hash, v T) { WriteComparable(h, v) }
func (ComparableHasher[T]) Equal(x, y T) bool     { return x == y }

// Implemented by the host.
func comparableHash(seed real.Seed, v any) uint64
func writeComparable(h *real.Hash, v any)
